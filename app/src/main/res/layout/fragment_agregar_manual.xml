<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".home.misPlantas.AgregarManualFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imgFotoManual"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:background="#E0E0E0"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@android:drawable/ic_menu_camera" />

        <Button
            android:id="@+id/btnBuscarPlanta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Buscar en Explorar"
            android:backgroundTint="#4CAF50"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgFotoManual" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilApodo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Apodo de la planta"
            app:layout_constraintTop_toBottomOf="@id/btnBuscarPlanta">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApodo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEspecie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Especie o tipo"
            app:layout_constraintTop_toBottomOf="@id/tilApodo">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEspecie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRiego"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Frecuencia de riego"
            app:layout_constraintTop_toBottomOf="@id/tilEspecie">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRiego"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLuz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Nivel de luz"
            app:layout_constraintTop_toBottomOf="@id/tilRiego">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLuz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnGuardarManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Guardar en mi jardín"
            app:layout_constraintTop_toBottomOf="@id/tilLuz" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>